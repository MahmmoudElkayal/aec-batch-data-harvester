<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!--
      Acceptance checks for the Phase 1 correctness fixes.

      A plain console program, not a test framework: `dotnet restore` for xunit/mstest
      hangs on this machine (no working NuGet feed), and a test harness that cannot run is
      worse than none. Everything here uses the shared framework only, so it builds and
      runs offline. Exit code 0 = all checks passed, 1 = something failed.
    -->
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<AssemblyName>Harvest.Checks</AssemblyName>
		<RootNamespace>Harvest.Checks</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<!--
      Only the AutoCAD-free project: this is what makes the checks runnable on a CI
      runner, and the reason the reference is to the core rather than to the plug-in.
    -->
		<ProjectReference Include="..\..\AEC_Batch_Data_Haravester.Core\AEC_Batch_Data_Haravester.Core.csproj" />
	</ItemGroup>

</Project>
